# TEMPLATE ONLY: do not put real keys in this file (it is uploaded to GitHub).
# Copy it to .env.local and fill in .env.local instead. .env.local stays on your computer.
# Supabase → Project Settings → API Keys (and Data API for the URL).

# --- Used by the app (built into the web page, so public values only) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Push notifications: public VAPID key (npm run push:keys makes a pair; the private
# key goes only into Supabase → Edge Functions → Secrets as VAPID_PRIVATE_KEY).
VITE_VAPID_PUBLIC_KEY=

# Where player reports go before Supabase is connected (opens the email app).
# Once Supabase is connected, set ADMIN_EMAIL as an Edge Function secret instead.
VITE_ADMIN_EMAIL=

# --- Used only by the scripts on your computer (never prefix these with VITE_) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Only for the optional question generator (npm run q:try / q:submit).
ANTHROPIC_API_KEY=

# Only for Tamil translation of Recall questions (npm run translate:recall).
# Google Cloud → APIs & Services → Credentials → API key (enable Cloud Translation API).
GOOGLE_TRANSLATE_API_KEY=
