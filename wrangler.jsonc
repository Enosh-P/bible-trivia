// Cloudflare Workers settings: serves the built app (dist/) as a static site.
// Used by "npx wrangler deploy" (Cloudflare Workers Builds). See docs/DEPLOY.md.
{
  "name": "bible-trivia",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    // Unknown paths open the app instead of a 404 page.
    "not_found_handling": "single-page-application"
  }
}
