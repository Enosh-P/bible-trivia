# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/)

# The service worker and its helpers must never be cached, or phones keep an old version.
/sw.js
  Cache-Control: no-cache
/registerSW.js
  Cache-Control: no-cache
/push-handler.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json

# Built files have a content hash in their name: safe to keep for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Question packs: refreshed hourly (the app also keeps them offline).
/packs/*
  Cache-Control: public, max-age=3600

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
