{
  "name": "bible-trivia",
  "version": "0.1.0",
  "description": "Tamil & English Bible trivia PWA",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "db:seed-sql": "node scripts/export-seed-sql.mjs",
    "q:plan": "node --env-file-if-exists=.env.local scripts/generate-questions.mjs plan",
    "q:try": "node --env-file-if-exists=.env.local scripts/generate-questions.mjs try",
    "q:submit": "node --env-file-if-exists=.env.local scripts/generate-questions.mjs submit",
    "q:collect": "node --env-file-if-exists=.env.local scripts/generate-questions.mjs collect",
    "db:import": "node --env-file-if-exists=.env.local scripts/import-to-supabase.mjs",
    "db:export": "node --env-file-if-exists=.env.local scripts/export-from-supabase.mjs",
    "content:uw": "node scripts/import-unfoldingword.mjs",
    "db:check": "node --env-file-if-exists=.env.local scripts/check-supabase.mjs",
    "db:setup-sql": "node scripts/export-seed-sql.mjs && node scripts/build-setup-sql.mjs",
    "translate:recall": "node --env-file-if-exists=.env.local scripts/translate-recall.mjs",
    "emails": "node scripts/build-email-templates.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/noto-sans-tamil": "^5.3.0",
    "@fontsource/noto-serif-tamil": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "dexie": "^4.4.7",
    "lucide-react": "^1.71.0",
    "motion": "^14.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module"
}
